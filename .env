# === Ortam Seçimi ===
SPRING_PROFILES_ACTIVE=dev  # Burayı 'prod' yaparak geçiş yapabilirsiniz

# === Veritabanı Ayarları ===
DATABASE_USERNAME=APUSYSDB
DATABASE_PASSWORD=AP:445609

# === Çalışma İzni Veritabanı ===
WORK_PERMISSION_DB_IP=localhost
WORK_PERMISSION_DB_PORT=5432

# === PostgreSQL Ayarları ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=apartmentservicedatabase
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_password

# === Grafana SMTP Ayarları ===
GF_SMTP_ENABLED=true  # SMTP'yi etkinleştiriyoruz
GF_SMTP_HOST=smtp.yourhost.com
GF_SMTP_USER=your_smtp_user
GF_SMTP_PASSWORD=your_smtp_password
GF_SMTP_SKIP_VERIFY=true
GF_SMTP_FROM_ADDRESS=your_email@example.com
